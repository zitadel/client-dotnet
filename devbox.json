{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "packages": [
    "dotnet-sdk_9@latest",
    "lefthook@latest",
    "docfx@latest"
  ],
  "env": {
    "NUGET_PACKAGES": "$DEVBOX_PROJECT_ROOT/.nuget/packages",
    "DOTNET_CLI_HOME": "$DEVBOX_PROJECT_ROOT/.dotnet",
    "DOTNET_ROLL_FORWARD": "Major"
  },
  "shell": {
    "init_hook": [
      "lefthook install",
      "dotnet restore"
    ],
    "scripts": {
      "format": [
        "dotnet format"
      ],
      "test": [
        "dotnet test"
      ],
      "check": [
        "dotnet build"
      ],
      "replit": [
        "docker build --tag csharp-repl --file Dockerfile .",
        "docker run --rm --interactive --tty csharp-repl"
      ],
      "docgen": [
        "docfx build"
      ]
    }
  }
}
