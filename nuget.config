<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
        Installability harness feed configuration.

        `<clear />` drops any inherited sources so the restore only sees the two
        feeds declared here. NuGet resolves the relative `local-feed` path against
        the directory of this file. In CI the SDK is packed into
        `$GITHUB_WORKSPACE/localfeed` and this project is checked out into
        `$GITHUB_WORKSPACE/project/sanity`, so `../../localfeed` resolves to the
        freshly packed feed. `nuget.org` is kept so transitive dependencies of
        the packed package still restore.
    -->
    <packageSources>
        <clear />
        <add key="local-feed" value="../../localfeed" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
</configuration>
