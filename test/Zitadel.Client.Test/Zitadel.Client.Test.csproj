<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <!-- xunit.v3 runs natively on Microsoft Testing Platform (MTP). Opt in
             so `dotnet test` dispatches to MTP instead of the legacy VSTest
             host, which silently skips container-backed collection specs. -->
        <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <ItemGroup>
        <!-- Pure Microsoft Testing Platform: xunit.v3 carries the MTP runner;
             the extensions add trx reporting and code coverage. No VSTest
             packages (Microsoft.NET.Test.Sdk / xunit.runner.visualstudio),
             which route `dotnet test` through VSTest and do not run the
             container collection specs. -->
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.7.3" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.4" />
        <PackageReference Include="Testcontainers" Version="4.12.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <None Update="xunit.runner.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Zitadel.Client\Zitadel.Client.csproj" />
    </ItemGroup>
</Project>
